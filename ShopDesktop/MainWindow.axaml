<!--
    Внешний вид окна. Каждый элемент — тег: <Button>, <TextBox>, <DataGrid>...
    x:Name="..." — имя элемента. По этому имени к нему обращаются из кода (MainWindow.axaml.cs).
    Click="...", TextChanged="..." — какой метод из MainWindow.axaml.cs вызвать, когда что-то произошло.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopDesktop.MainWindow"
        Title="Рога и Копыта — менеджер"
        Width="1000" Height="650"
        Loaded="Window_Loaded">

    <DockPanel Margin="12">

        <!-- Строка сообщений внизу окна -->
        <TextBlock x:Name="MessageText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   FontWeight="SemiBold" Foreground="DarkBlue" TextWrapping="Wrap" />

        <TabControl x:Name="Tabs">

            <!-- ==================== Вкладка «Товары» ==================== -->
            <TabItem Header="Товары">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8" Margin="0,8,0,0">

                    <!-- Фильтры -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="CategoryBox" Width="200" SelectionChanged="Filter_Changed" />
                        <TextBox x:Name="SearchBox" Width="250" PlaceholderText="Поиск по названию"
                                 TextChanged="Filter_Changed" />
                        <CheckBox x:Name="InStockBox" Content="Только в наличии"
                                  IsCheckedChanged="Filter_Changed" />
                    </StackPanel>

                    <!-- Таблица товаров. Binding="{Binding Name}" — показать в столбце свойство Name товара -->
                    <DataGrid Grid.Row="1" x:Name="ProductsGrid" IsReadOnly="True"
                              GridLinesVisibility="All" BorderThickness="1" BorderBrush="LightGray">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                            <!-- ПОДСКАЗКА: что то тут не так...                   ТУТ -->
                            <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price}" Width="120" />
                            <!-- ПОДСКАЗКА: Price - это цена, а нам нужен остаток. Посмотри в Models/Models.cs, какие есть параметры у Товара -->
                            <DataGridTextColumn Header="Остаток, шт." Binding="{Binding Stock}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="FoundText" />

                    <!-- Форма «Новый товар» -->
                    <Border Grid.Row="3" BorderThickness="1" BorderBrush="LightGray" CornerRadius="4" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Новый товар:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="NameBox" Width="220" PlaceholderText="Название" />
                            <TextBox x:Name="PriceBox" Width="100" PlaceholderText="Цена" />
                            <TextBox x:Name="StockBox" Width="100" PlaceholderText="Остаток" />
                            <ComboBox x:Name="NewCategoryBox" Width="160" PlaceholderText="Категория" />
                            <Button Content="Добавить" Click="AddProduct_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== Вкладка «Заказы» ==================== -->
            <TabItem Header="Заказы">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">

                    <!-- Слева — все заказы -->
                    <DataGrid Grid.Column="0" x:Name="OrdersGrid" IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="All" BorderThickness="1" BorderBrush="LightGray"
                              SelectionChanged="OrdersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ заказа" Binding="{Binding Id}" Width="Auto" />
                            <DataGridTextColumn Header="№ клиента" Binding="{Binding ClientId}" Width="Auto" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate}" Width="*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Справа — строки выбранного заказа -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="Состав заказа" FontWeight="SemiBold" />

                        <DataGrid Grid.Row="1" x:Name="ItemsGrid" IsReadOnly="True"
                                  GridLinesVisibility="All" BorderThickness="1" BorderBrush="LightGray">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№ товара" Binding="{Binding ProductId}" Width="*" />
                                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="*" />
                                <DataGridTextColumn Header="Цена за шт., ₽" Binding="{Binding Price}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" x:Name="TotalText" FontSize="18" FontWeight="Bold" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="StatusBox" Width="160" PlaceholderText="Статус" />
                            <Button Content="Сменить статус" Click="SetStatus_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
